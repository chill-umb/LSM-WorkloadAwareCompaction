*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# working files
logs
**.log
workload.txt

# db_working_home
**/db/**

# bin
**/bin/**

# build
**/build/**
/build-dbbench/*
# 01c's stock source and build trees (config.sh STOCK_*)
/build-dbbench-*/

# venv
.venv
.venv-dbbench/*

# python
__pycache__/
*.pyc

# metrics
*.jsonl
scripts/*
!scripts/
!scripts/*.sh
# Everything in scripts/ is source, not output. Listing individual .py files
# here meant new analysis scripts were silently ignored and never reached
# another machine — which is why run_pressure_experiment.sh carries a check for
# a missing check_pressure.py. Generated artefacts are covered by the
# __pycache__ and *.jsonl rules above.
!scripts/*.py
!scripts/dbbench_pipeline/
!scripts/dbbench_pipeline/*.sh
!scripts/dbbench_pipeline/*.py
!scripts/dbbench_pipeline/*.md

# results
results/*
baseline_slo*
baseline_selection*
gate1
*.tex
# The LaTeX reading copy of PATHWAYS.md is kept; its PDF is rebuilt locally.
!/docs/PATHWAYS.tex
/docs/PATHWAYS.pdf
*.tgz

# Generated text and JSON outputs; configs are re-included one by one.
*.txt
*.json
!config/research_objective_contract.json
!config/admission_test.json
# The controller arms' inputs (03, plugin_config.py): D-18's bounds and the
# Gate N3 settings, committed when preregistered.
!config/action_bounds.json
!config/controller_rules.json
# The controller plugin's build file (plan §8). Its per-arm config is composed by
# the pipeline, not committed, so it has no re-include.
!controller/CMakeLists.txt

# docs/ is deliberately NOT ignored (b253e85, 2026-09-21). PREREGISTRATION.md
# must keep its commit date to be worth anything, and PATHWAYS.md and
# EXPERIMENTAL_SETUP.md are current authority. Do not re-add a /docs/* rule.

# Some sketchy executable file
linux-x64

build-bench/

# Databases created by scripts/run_vanilla_sweep.sh. Kept on the project
# partition rather than /tmp, which is tmpfs here — a multi-GB db_bench run
# there would sit in RAM and measure page-cache speed instead of disk.
.dbbench_*/

# Artifacts from before the Gate 2 rebuild (2026-09-20). Invalidated by three
# simultaneous changes: a new db_bench binary, the in-place contract amendment,
# and a measured phase that now excludes the bulk load. Structure is preserved,
# so any path the project record cites resolves by prefixing this directory.
deprecated/

# graphify
graphify-out/

# Tests (plan §6). Fixtures are source even when they end in .log, .txt or
# .json, which the rules above hide; this must stay after them. The Debug test
# tree of 01b is build output.
!**/tests/fixtures/**
/build-dbbench-debug/
# The plugin's Release tree (13) and Debug test tree (01b).
/build-controller/
/build-controller-debug/

# Editor swap and backup files. The preflight marker hashes every file git
# does not ignore under the pipeline and rl_agent/, so one of these appearing
# mid-night would make every later 03 run refuse (exit 7). Last, so they stay
# ignored under tests/fixtures too.
*.swp
*.swo
*~
.#*
.nfs*

