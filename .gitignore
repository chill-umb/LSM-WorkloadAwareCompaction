# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# working files
logs
**.log
workload.txt

# db_working_home
**/db/**

# bin
**/bin/**

# build
**/build/**
/build-dbbench/*

# venv
.venv
.venv-dbbench/*

# python
__pycache__/
*.pyc

# metrics
*.jsonl
scripts/*
!scripts/
!scripts/*.sh
# Everything in scripts/ is source, not output. Listing individual .py files
# here meant new analysis scripts were silently ignored and never reached
# another machine — which is why run_pressure_experiment.sh carries a check for
# a missing check_pressure.py. Generated artefacts are covered by the
# __pycache__ and *.jsonl rules above.
!scripts/*.py
!scripts/dbbench_pipeline/
!scripts/dbbench_pipeline/*.sh
!scripts/dbbench_pipeline/*.py
!scripts/dbbench_pipeline/*.md

# results
results/*

# workloads
# Generated workload files are large and reproducible from their specs, so they
# stay out of the repo. The SPECS are source and must travel with it, otherwise
# a fresh machine cannot regenerate the workloads at all.
*.txt
*.json
!workload_specs/**/*.json
!workload_specs/**/*.md

# Documentations
/docs/*
!/docs/RESEARCH_OBJECTIVE_CONTRACT.md
!/docs/PATHWAY_IMPLEMENTATION_STATUS.md

# Some sketchy executable file
linux-x64

build-bench/

# Databases created by scripts/run_vanilla_sweep.sh. Kept on the project
# partition rather than /tmp, which is tmpfs here — a multi-GB db_bench run
# there would sit in RAM and measure page-cache speed instead of disk.
.dbbench/

# graphify
graphify-out/